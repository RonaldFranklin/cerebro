# Cérebro configuration. Every value below is a placeholder: use your own, and keep your copy out of Git.
#
# Two ways to run:
#   A. Docker Compose (README quickstart). Copy this file, edit sections "Both" and "A", and pass it to
#      `docker compose --env-file FILE` and `deploy/start.sh FILE`. Variables already exported in your
#      shell override the file.
#   B. From source (development). Export the variables of sections "Both" and "B" in your shell, or pass
#      `--config FILE` with top-level TOML keys: content_dir, state_dir, key_file, git_name, git_email and
#      optionally index_dir, git_branch, git_remote, writes_per_hour. Environment variables override TOML.
#      Relative environment paths resolve against the working directory; relative TOML paths resolve
#      against the TOML file.

# --- Both ----------------------------------------------------------------------------------------

# Author recorded on content commits. Required.
CEREBRO_GIT_NAME="Example Owner"
CEREBRO_GIT_EMAIL=owner@example.invalid

# --- A. Docker Compose ---------------------------------------------------------------------------

# Environment name: prod or hml. Names the Compose project (cerebro-<name>) and the content branch.
ENVIRONMENT=prod
# Application commit that tags the image cerebro-backend:git-<APP_SHA>. Use: git rev-parse HEAD
APP_SHA=0000000000000000000000000000000000000000
# Absolute directory named like ENVIRONMENT, outside the repository. It must already contain the
# directories content, state, index and secrets, owned by SERVICE_UID with mode 0700.
DATA_DIR=/absolute/path/to/cerebro-instance/prod
# Non-root user and group of the container. Use: id -u and id -g
SERVICE_UID=1000
SERVICE_GID=1000
# Host loopback ports. They must differ.
PRIVATE_PORT=8765
PUBLIC_PORT=8766
# HTTPS origins at which browsers reach the web UI, without path or trailing slash. Both are
# required and must differ.
PRIVATE_ORIGIN=https://localhost:8443
PUBLIC_ORIGIN=https://localhost:8444
# Highest sensitivity MCP serves on the public listener: public, internal (default) or restricted.
# A request gets the lower of this and its token's ceiling (ADR-0028). The owner's browser is
# restricted on both entrances: put an identity layer in front of a published public port (ADR-0029).
PUBLIC_CEILING=internal

# --- B. From source ------------------------------------------------------------------------------
# Compose sets these inside the container, so it ignores the values given here.

# Content repository (notes), state directory and encryption key. Keep all three separate and
# outside the application repository.
CEREBRO_CONTENT_DIR=/absolute/path/to/cerebro-instance/content
CEREBRO_STATE_DIR=/absolute/path/to/cerebro-instance/state
CEREBRO_KEY_FILE=/absolute/path/to/cerebro-instance/secrets/fernet.key
CEREBRO_GIT_BRANCH=main
# Optional: directory for the rebuildable plaintext search index (default: the state directory).
# CEREBRO_INDEX_DIR=/absolute/path/to/cerebro-instance/index
# Optional: name or URL of a private backup remote of the content repository (default: none).
# CEREBRO_GIT_REMOTE=
# Write attempts per token in a rolling hour (default 60). The Compose file does not forward it.
CEREBRO_WRITES_PER_HOUR=60

# Listeners are command-line flags when running from source:
#   cerebro-mcp [--config FILE] [--private-port 8765] [--private-origin URL] [--web-dist DIR]
#               [--enable-public --public-port 8766 --public-origin URL --public-ceiling internal]
#
# CEREBRO_MCP_TOKEN is read only by the development bridge cerebro-mcp-stdio. Set it for that
# process alone; never put a token in this file.
