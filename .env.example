# Example configuration for a local dev instance. Copy to `.env` and adjust; `.env` is never committed.
# Placeholders only: no real hostnames, IPs, domains, tokens or keys belong in this repository.
# Variable names are provisional until `cerebro.bootstrap.settings` is implemented (Phase 3).

# Environment name: dev | hml | prod
CEREBRO_ENV=dev

# Working copy of the private content repository (notes).
CEREBRO_CONTENT_DIR=./var/content

# Derived index and state (index.sqlite, state.sqlite). Not in git.
CEREBRO_STATE_DIR=./var/state

# Secrets directory (Fernet key, admin password hash). Never committed; keep an offline copy of the key.
CEREBRO_SECRETS_DIR=./var/secrets
