# Local dev example. Export these variables in your shell before invoking cerebro.
# Alternatively pass --config FILE, with top-level TOML strings named content_dir,
# state_dir, key_file, git_name, git_email and optionally git_branch and git_remote.
# Environment overrides resolve relative paths against the current working directory.
# Paths supplied in TOML resolve relative to the TOML file.

CEREBRO_CONTENT_DIR=./var/content
CEREBRO_STATE_DIR=./var/state
CEREBRO_KEY_FILE=./var/secrets/fernet.key
CEREBRO_GIT_NAME="Example Owner"
CEREBRO_GIT_EMAIL=owner@example.invalid
CEREBRO_GIT_BRANCH=main
