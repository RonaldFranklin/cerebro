# Local dev example. Export these variables in your shell before invoking cerebro.
# Replace the /absolute/path/to placeholders. The content directory becomes its own private git repository;
# keep it outside the application repository, and keep the state directory and key outside both repositories.
# Alternatively pass --config FILE, with top-level TOML strings named content_dir,
# state_dir, key_file, git_name, git_email and optionally git_branch and git_remote.
# Environment overrides resolve relative paths against the current working directory.
# Paths supplied in TOML resolve relative to the TOML file.

CEREBRO_CONTENT_DIR=/absolute/path/to/cerebro-instance/content
CEREBRO_STATE_DIR=/absolute/path/to/cerebro-instance/state
CEREBRO_KEY_FILE=/absolute/path/to/cerebro-instance/secrets/fernet.key
CEREBRO_GIT_NAME="Example Owner"
CEREBRO_GIT_EMAIL=owner@example.invalid
CEREBRO_GIT_BRANCH=main

# Start the private MCP listener with cerebro-mcp --config FILE.
# Loopback defaults: private port 8765, public port 8766 (disabled unless --enable-public).
# For local development, pass CEREBRO_MCP_TOKEN only to the cerebro-mcp-stdio process.


# Per authenticated token: direct write attempts in a rolling hour.
CEREBRO_WRITES_PER_HOUR=60
